# Example .envrc for Feynman Chiron
# Copy this to your learning directory (e.g., ~/Learning/.envrc)

# Base PostgreSQL database URL (required)
# All learning files will use this database with different schemas
export CHIRON_DATABASE_URL="postgresql://user:password@server:5432/chiron"

# Alternative: Use .pgpass for password instead of putting it in the URL
# If you have ~/.pgpass configured, omit password from URL:
# export CHIRON_DATABASE_URL="postgresql://user@server:5432/chiron"
#
# ~/.pgpass format:
# server:5432:chiron:user:password
# or with wildcards:
# server:*:*:user:password

# No API key is needed here for textbook ingestion: chiron-ingest embeds
# locally via a bundled MiniLM model (same as chiron-rs), not a cloud API.
# CHIRON_API_KEY / ANTHROPIC_API_KEY / OPENAI_API_KEY are only needed by the
# chiron-rs agent itself, configured via Emacs (feynman-chiron-anthropic-key
# / feynman-chiron-openai-key), not this file.

# Use Nix flake for the Rust toolchain
use flake

# After copying and editing, run:
#   cd ~/Learning
#   direnv allow
